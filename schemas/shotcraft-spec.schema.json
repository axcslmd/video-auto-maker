{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shotcraft Render Specification",
  "type": "object",
  "required": ["schema_version", "width", "height", "fps", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "width": {"type": "integer", "minimum": 16},
    "height": {"type": "integer", "minimum": 16},
    "fps": {"type": "integer", "minimum": 1},
    "brand_token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "card_id", "shotcraft_card_id", "motion_intent", "renderer", "primary_effect", "durationInFrames", "hold_frames", "transition", "motion_blur", "brand_token_sha256", "safe_zone_provenance", "text_ownership", "postproduction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "card_id": {"type": "string", "minLength": 1},
          "shotcraft_card_id": {"type": "string", "minLength": 1},
          "motion_intent": {"type": "string", "minLength": 1},
          "renderer": {"type": "string", "minLength": 1},
          "primary_effect": {"type": "string", "minLength": 1},
          "durationInFrames": {"type": "integer", "minimum": 1},
          "hold_frames": {"type": "integer", "minimum": 1},
          "brand_token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "text_ownership": {"const": "hyperframes"},
          "transition": {"type": "object", "required": ["style", "duration_frames", "beat_source"], "properties": {"style": {"type": "string"}, "duration_frames": {"type": "integer", "minimum": 0}, "beat_frame": {"type": ["integer", "null"]}, "beat_source": {"type": "string"}}},
          "motion_blur": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "shutter_angle": {"type": "number", "minimum": 0}, "samples": {"type": "integer", "minimum": 1}}},
          "safe_zone_provenance": {"type": "object", "required": ["source", "status"], "properties": {"source": {"type": "string"}, "status": {"type": "string"}}},
          "postproduction": {"type": "object"}
        }
      }
    }
  }
}
