{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable pre-render quality specification",
  "type": "object",
  "required": ["schema_version", "type", "mode", "target", "design_tokens", "visual_intent", "layout_contract", "audio_choreography", "renderer", "source_contracts", "engine_props", "unresolved", "contract_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "render_quality_spec"},
    "mode": {"enum": ["draft", "formal"]},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object",
      "required": ["ratio", "width", "height", "fps"],
      "properties": {
        "ratio": {"enum": ["16:9", "9:16", "1:1", "4:3", "3:4"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "design_tokens": {"type": "object"},
    "visual_intent": {"type": "object"},
    "layout_contract": {"type": "object"},
    "audio_choreography": {"type": "object"},
    "renderer": {
      "type": "object",
      "required": ["engine", "composition", "render_profile", "frame_format", "color_space", "single_lossy_encode"],
      "properties": {
        "engine": {"const": "remotion"},
        "composition": {"enum": ["Shots", "Content", "HorizontalKinetic", "IntegratedExplainer", "Shotcraft"]},
        "render_profile": {"enum": ["preview", "direct_delivery", "commercial_master"]},
        "frame_format": {"enum": ["jpeg", "png"]},
        "color_space": {"const": "bt709"},
        "single_lossy_encode": {"const": true}
      }
    },
    "source_contracts": {"type": "object"},
    "engine_props": {"type": ["object", "null"]},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
